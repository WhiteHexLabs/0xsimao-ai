{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whitehexlabs.audit-findings-index/v1",
  "title": "whitehexlabs.audit-findings-index/v1",
  "description": "Cross-skill findings index emitted by 0xsimao-ai. Field schema is whitehexlabs.audit-findings-index/v1. Strings are complete; do not clip evidence, descriptions, or mitigations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "producer",
    "run_id",
    "target",
    "scope",
    "report_path",
    "log_path",
    "counts",
    "findings"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "enum": ["whitehexlabs.audit-findings-index/v1"]
    },
    "producer": {
      "type": "string",
      "enum": ["0xsimao-ai"]
    },
    "run_id": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "scope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "report_path": { "type": "string", "minLength": 1 },
    "log_path": { "type": "string", "minLength": 1 },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "high", "medium", "low", "info", "leads"],
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 },
        "leads": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "severity",
        "title",
        "contract",
        "function",
        "bug_class",
        "group_key",
        "locations",
        "root_cause",
        "description",
        "impact",
        "mitigation",
        "evidence",
        "lenses"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["finding", "lead"] },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low", "info", "unverified"]
        },
        "title": { "type": "string", "minLength": 1 },
        "contract": { "type": "string", "minLength": 1 },
        "function": { "type": "string", "minLength": 1 },
        "bug_class": { "type": "string", "minLength": 1 },
        "group_key": { "type": "string", "minLength": 1 },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/location" }
        },
        "root_cause": { "type": "string", "minLength": 1 },
        "internal_pre": { "type": "string" },
        "external_pre": { "type": "string" },
        "path": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "description": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "mitigation": { "type": "string", "minLength": 1 },
        "chain": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "lenses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1, "maximum": 12 }
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "contract": { "type": "string" },
        "function": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line", "detail"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "detail": {
          "type": "string",
          "minLength": 1,
          "description": "Full root-cause citation or quoted lines. Never a clipped preview."
        }
      }
    }
  }
}
