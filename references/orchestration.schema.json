{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/0xsimao/0xsimao-ai/main/references/orchestration.schema.json",
  "title": "0xSimao AI orchestration configuration",
  "description": "Strict schema for orchestration-defaults.json and every --config overlay. Unknown keys are rejected so typos fail before any lens spawns. Class limits are validated standalone; maxActive is deliberately NOT constrained to maxConcurrency here, because effective class limits are clamped against the effective concurrency at resolve time (so --concurrency 1 stays valid next to the default deep maxActive 2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "maxConcurrency",
    "defaultModelClass",
    "modelClasses",
    "lensAssignments"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "maxConcurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "defaultModelClass": {
      "type": "string",
      "minLength": 1
    },
    "modelFallbacks": {
      "type": "object",
      "description": "Per-model fallback chain, applied at most once when the model is rejected before the worker starts.",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "modelClasses": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "preferredActive": {
            "type": "integer",
            "minimum": 0
          },
          "maxActive": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "lensAssignments": {
      "type": "object",
      "description": "Keys are lens IDs 1..12 only. A partial overlay merges by lens ID over the defaults; a full merged config must cover all 12.",
      "patternProperties": {
        "^([1-9]|1[0-2])$": {
          "$ref": "#/$defs/lensAssignment"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "lensAssignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelClass": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "integer"
        }
      }
    }
  }
}
